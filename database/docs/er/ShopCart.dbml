  "Motivo" "nvarchar(300)" [not null]
  "Fecha" "datetime2(3)" [not null]
}

Table "Ventas"."DevolucionDetalle" {
  "IDDevolucionDetalle" "bigint" [pk, increment]
  "IDDevolucion" "bigint" [not null]
  "IDPedidoDetalle" "bigint" [not null]
  "IDBodega" "int" [not null]
  "Cantidad" "int" [not null]
  "Monto" "decimal(18,2)" [not null]
  "ReingresaInventario" "bit" [not null]
  indexes {
    ("IDDevolucion", "IDPedidoDetalle") [unique]
  }
}

Table "Ventas"."Reembolso" {
  "IDReembolso" "bigint" [pk, increment]
  "IDPedido" "bigint" [not null]
  "IDDevolucion" "bigint"
  "Monto" "decimal(18,2)" [not null]
  "Estado" "varchar(10)" [not null]
  "Referencia" "varchar(100)"
  "Fecha" "datetime2(3)" [not null]
}

Table "Ventas"."Factura" {
  "IDFactura" "bigint" [pk, increment]
  "IDPedido" "bigint" [unique, not null]
  "NumeroAutorizacion" "varchar(40)"
  "Serie" "varchar(20)"
  "Numero" "varchar(20)"
  "Estado" "varchar(12)" [not null]
  "FechaCertificacion" "datetime2(3)"
}

Table "Ventas"."EventoSalida" {
  "IDEventoSalida" "bigint" [pk, increment]
  "TipoEvento" "varchar(50)" [not null]
  "Contenido" "nvarchar(max)" [not null]
  "CreadoEn" "datetime2(3)" [not null]
  "ProcesadoEn" "datetime2(3)"
}

