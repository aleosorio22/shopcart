NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Conexion. DB_USER es el login shopcart_api creado por 013_Roles_Permisos.sql
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ShopCart
DB_USER=shopcart_api
DB_PASSWORD=
DB_JOBS_USER=shopcart_jobs
DB_JOBS_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_CERT=true

# Minimo 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
BCRYPT_COST=12

# Origenes permitidos, separados por coma
CORS_ORIGINS=http://localhost:5173
# Numero de proxies delante del API; 0 si se expone directo
TRUST_PROXY=0
JOBS_ENABLED=true

# Carpeta donde se guardan las imagenes subidas desde el panel (relativa a backend/)
UPLOADS_DIR=uploads
