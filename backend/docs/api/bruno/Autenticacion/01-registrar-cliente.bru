meta {
  name: Registrar cliente
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/registro
  body: json
  auth: none
}

body:json {
  {
    "correo": "nuevo@shopcart.test",
    "contrasena": "ClaveSegura2026",
    "nombres": "Nuevo",
    "apellidos": "Cliente"
  }
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar('accessToken', res.body.data.accessToken);
  }
}

docs {
