meta {
  name: Iniciar sesion como Administrador
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correo": "admin@shopcart.test",
    "contrasena": "ShopCart#2026"
  }
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar('accessToken', res.body.data.accessToken);
  }
}

docs {
  Iniciar sesion
}
