meta {
  name: Renovar el access token y rotar el refresh token
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: none
  auth: none
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar('accessToken', res.body.data.accessToken);
  }
}

docs {
  Renovar el access token y rotar el refresh token
}
